FROM php:7.4-apache

WORKDIR /var/www/html

COPY . /var/www/html

RUN a2enmod rewrite

RUN chown -R www-data:www-data /var/www/html

RUN printf '%s\n' \
    '<VirtualHost *:80>' \
    '    DocumentRoot /var/www/html/public' \
    '    <Directory /var/www/html/public>' \
    '        AllowOverride All' \
    '        Require all granted' \
    '    </Directory>' \
    '</VirtualHost>' \
    > /etc/apache2/sites-available/000-default.conf

EXPOSE 80

CMD ["apache2-foreground"]